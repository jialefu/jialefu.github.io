<div class="news">
  {% if site.news != blank %}
    {% assign news = site.news | reverse %}
    {% assign news_limit = site.news.size %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% endif %}
    <ul class="news-list">
      {% for item in news limit: news_limit %}
        <li>
          <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{% if item.display_date %}{{ item.display_date }}{% else %}{{ item.date | date: '%b %d, %Y' }}{% endif %}</time>
          <div class="news-copy">
            {% if item.inline %}
              {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
            {% else %}
              <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p>No news so far.</p>
  {% endif %}
</div>
