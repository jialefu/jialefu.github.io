<header class="site-header">
  <nav id="navbar" class="academic-navbar {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" aria-label="Main navigation">
    <div class="container nav-inner">
      <a class="nav-signature" href="{{ '/' | relative_url }}">{{ site.first_name }} {{ site.last_name }}</a>
      <div class="nav-links">
        {% for item in site.data.navigation %}
          <a class="nav-link" href="{{ item.url | relative_url }}" {% if page.url contains '/blog/' and item.url == '/blog/' %}aria-current="page"{% elsif page.permalink == '/' and forloop.first %}aria-current="location"{% endif %}>{{ item.title }}</a>
        {% endfor %}
      </div>
      {% if site.enable_darkmode %}
        <button id="light-toggle" title="Change theme" aria-label="Change color theme">
          <i class="fa-half-sun-moon" id="light-toggle-system" aria-hidden="true"></i>
          <i class="fa-solid fa-moon" id="light-toggle-dark" aria-hidden="true"></i>
          <i class="fa-solid fa-sun" id="light-toggle-light" aria-hidden="true"></i>
        </button>
      {% endif %}
    </div>
  </nav>
</header>
