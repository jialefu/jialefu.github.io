<div class="publication-stack">
  {% for paper in include.items %}
    <article class="publication-card">
      <a class="publication-thumb" href="{{ paper.title_url }}">
        <img
          src="{{ '/assets/img/publication_preview/' | append: paper.teaser | relative_url }}"
          alt="Teaser for {{ paper.title }}"
        >
      </a>

      <div class="publication-body">
        <div class="publication-meta">{{ paper.venue }}</div>
        <h3 class="publication-title"><a href="{{ paper.title_url }}">{{ paper.title }}</a></h3>
        <p class="publication-authors">{{ paper.authors }}</p>
        <p class="publication-summary">{{ paper.summary }}</p>
        <div class="publication-links">
          {% for link in paper.links %}
            <a class="btn btn-sm z-depth-0" href="{{ link.url }}">{{ link.label }}</a>
          {% endfor %}
        </div>
      </div>
    </article>
  {% endfor %}
</div>
