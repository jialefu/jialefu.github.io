---
layout: default
---
<div class="academic-home">
  <section class="about-intro" id="about" aria-labelledby="profile-name">
    <header class="identity">
      <h1 class="signature" id="profile-name">{{ site.first_name }} {{ site.last_name }}</h1>
      <p class="identity-subtitle">{{ page.subtitle }}</p>
      <div class="profile-links" aria-label="Contact and profiles">
        <a href="mailto:{{ site.data.socials.email }}" aria-label="Email" title="Email"><i class="fa-regular fa-envelope" aria-hidden="true"></i></a>
        <a href="https://github.com/{{ site.data.socials.github_username }}" aria-label="GitHub" title="GitHub"><i class="fa-brands fa-github" aria-hidden="true"></i></a>
        <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" aria-label="Google Scholar" title="Google Scholar"><i class="ai ai-google-scholar" aria-hidden="true"></i></a>
        <a href="{{ '/blog/' | relative_url }}" aria-label="Blog" title="Blog"><i class="fa-solid fa-pen-nib" aria-hidden="true"></i></a>
      </div>
    </header>
    <div class="intro-copy">{{ content }}</div>
    {% if page.profile.image %}
      <figure class="profile-portrait">
        <img src="{{ page.profile.image | prepend: '/assets/img/' | relative_url | bust_file_cache }}" alt="Jiale Fu's profile illustration" width="270" height="270" fetchpriority="high">
        <figcaption><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Nanjing, China</figcaption>
      </figure>
    {% endif %}
    <p class="research-interests"><span>Research interests</span> Speculative decoding · Sparse and linear attention · Algorithm–infrastructure co-design</p>
  </section>

  <section class="academic-section" id="news" aria-labelledby="news-heading">
    <div class="section-heading">
      <h2 id="news-heading"><i class="fa-regular fa-newspaper" aria-hidden="true"></i> News</h2>
      <a class="section-link" href="{{ '/news/' | relative_url }}">All updates <span aria-hidden="true">↗</span></a>
    </div>
    {% include news.liquid limit=true %}
  </section>

  <section class="academic-section" id="education" aria-labelledby="education-heading">
    <div class="section-heading">
      <h2 id="education-heading"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i> Education</h2>
    </div>
    <div class="organization-options education-options">
      {% for item in site.data.education %}
        <article class="organization-card education-card">
          <span class="organization-logo" aria-hidden="true"><img src="{{ item.logo | prepend: '/assets/img/organizations/' | relative_url }}" alt="" width="48" height="48" loading="lazy"></span>
          <div class="organization-summary">
            <h3 class="organization-name"><a href="{{ item.url }}">{{ item.institution }}</a></h3>
            <p class="organization-role">{{ item.degree }}</p>
            <p class="entry-date">{{ item.dates }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  </section>

  <section class="academic-section" id="experience" aria-labelledby="experience-heading">
    <div class="section-heading">
      <h2 id="experience-heading"><i class="fa-solid fa-briefcase" aria-hidden="true"></i> Internships</h2>
    </div>
    <div class="organization-disclosure" data-organization-group>
      <div class="organization-options internship-options" aria-label="Internship details">
        {% for item in site.data.experience %}
          <button class="organization-button" type="button" id="internship-button-{{ forloop.index }}" aria-expanded="false" aria-controls="internship-panel-{{ forloop.index }}">
            <span class="organization-logo{% if item.logo_size == 'small' %} organization-logo-small{% endif %}" aria-hidden="true"><img src="{{ item.logo | prepend: '/assets/img/organizations/' | relative_url }}" alt="" width="48" height="48" loading="lazy"></span>
            <span class="organization-summary">
              <span class="organization-name">{{ item.label | default: item.organization }}</span>
              <span class="organization-role">{{ item.summary_role | default: item.role }}</span>
              <span class="entry-date">{{ item.dates }}</span>
            </span>
            <i class="fa-solid fa-chevron-down organization-chevron" aria-hidden="true"></i>
          </button>
          <div class="organization-panel" id="internship-panel-{{ forloop.index }}" role="region" aria-labelledby="internship-button-{{ forloop.index }}" aria-hidden="true" hidden inert>
            <div class="organization-panel-inner">
              <div class="internship-detail">
                <header class="internship-detail-header">
                  <span class="organization-logo detail-logo{% if item.logo_size == 'small' %} organization-logo-small{% endif %}" aria-hidden="true"><img src="{{ item.logo | prepend: '/assets/img/organizations/' | relative_url }}" alt="" width="64" height="64" loading="lazy"></span>
                  <div class="internship-detail-title">
                    <h3><a href="{{ item.url }}">{{ item.organization }} <span aria-hidden="true">↗</span></a></h3>
                    <p>{{ item.role }}</p>
                  </div>
                  <div class="internship-detail-meta">
                    <span class="detail-date"><i class="fa-regular fa-calendar" aria-hidden="true"></i> {{ item.dates }}</span>
                    <span class="detail-location"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> {{ item.location }}</span>
                  </div>
                  <button class="organization-close" type="button" aria-label="Close {{ item.organization }} internship details"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
                </header>
                <div class="internship-detail-body">
                  <div class="detail-field">
                    <span class="detail-field-label">Work</span>
                    <p>{{ item.description }}</p>
                  </div>
                  {% if item.mentor %}
                    <div class="detail-field">
                      <span class="detail-field-label">Mentor</span>
                      <p>{% if item.mentor_url %}<a href="{{ item.mentor_url }}">{{ item.mentor }}</a>{% else %}{{ item.mentor }}{% endif %}</p>
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {% if page.selected_papers %}
    <section class="academic-section" id="publications" aria-labelledby="publications-heading">
      <div class="section-heading">
        <h2 id="publications-heading"><i class="fa-regular fa-file-lines" aria-hidden="true"></i> Selected Publications</h2>
        <a class="section-link" href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">↗</span></a>
      </div>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  <section class="academic-section" id="writing" aria-labelledby="writing-heading">
    <div class="section-heading">
      <h2 id="writing-heading"><i class="fa-solid fa-pen-nib" aria-hidden="true"></i> Blogs &amp; Notes</h2>
      <a class="section-link" href="{{ '/blog/' | relative_url }}">All writing <span aria-hidden="true">↗</span></a>
    </div>
    <div class="writing-list">
      {% for item in site.data.writing %}
        <article class="writing-entry">
          <span class="entry-date">{{ item.year }}</span>
          <div>
            <h3><a href="{% if item.external %}{{ item.url }}{% else %}{{ item.url | relative_url }}{% endif %}">{{ item.title }}{% if item.external %} <span class="external-arrow" aria-hidden="true">↗</span>{% endif %}</a></h3>
            <p class="entry-detail">{{ item.description }}</p>
            <p class="writing-source">{{ item.source }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  </section>
</div>
